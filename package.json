{
  "name": "2-racemap-forwarder",
  "version": "1.1.4",
  "description": "Forwards reads from MyLaps and ChronoTrack timing systems to RACEMAP",
  "main": "out/main/index.js",
  "author": "Jens Haupt <jens.haupt@racemap.com> (https://racemap.com)",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "yarn build-tests && dotenv-load ava .build/test-2-racemap-forwarder.js",
    "postinstall": "electron-builder install-app-deps",
    "build": "npm run typecheck && electron-vite build",
    "build-tests": "node ./tools/build-tests.mjs",
    "build-unpack": "npm run build && electron-builder --dir",
    "build-win": "npm run build && electron-builder --win",
    "build-mac": "npm run build && electron-builder --mac",
    "build-linux": "npm run build && electron-builder --linux",
    "check": "biome check .",
    "fix": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@ant-design/icons": "^5",
    "@biomejs/biome": "^2.5.14",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@types/lodash": "^4.17.9",
    "@types/node": "^18.19.86",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/shortid": "^0.0.32",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.24.8",
    "ava": "^3.15.0",
    "classnames": "^2.2.6",
    "dotenv-load": "^3.0.0",
    "electron": "^35.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "esbuild": "^0.25.4",
    "husky": "^9.1.7",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-json-view-lite": "^2.5.0",
    "shortid": "^2.2.16",
    "styled-components": "^6.1.17",
    "typescript": "^5.6.2",
    "vite": "^6.3.3",
    "with-query": "^1.3.0"
  },
  "ava": {
    "verbose": true,
    "cache": false,
    "timeout": "30s",
    "files": [
      ".build/test-2-racemap-forwarder.js"
    ]
  }
}
